<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_vertical" android:padding="28dp">
        <TextView android:layout_width="80dp" android:layout_height="80dp" android:layout_gravity="center_horizontal" android:gravity="center" android:text="@string/login_monogram" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold" android:background="@drawable/login_mark" android:layout_marginTop="24dp" android:layout_marginBottom="24dp" android:importantForAccessibility="no" />
        <TextView style="@style/ScreenHeading" android:text="@string/app_name" android:gravity="center" android:textSize="27sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/login_subtitle" android:textSize="15sp" android:gravity="center" android:textColor="@color/text_secondary" android:layout_marginTop="10dp" android:layout_marginBottom="28dp" />
        <LinearLayout style="@style/SectionCard" android:padding="20dp">
            <TextView style="@style/FieldLabel" android:text="@string/username" android:layout_marginTop="0dp" />
            <EditText android:id="@+id/username" style="@style/TextField" android:hint="@string/username" android:inputType="text" android:autofillHints="username" android:imeOptions="actionNext" />
            <TextView style="@style/FieldLabel" android:text="@string/password" />
            <EditText android:id="@+id/password" style="@style/TextField" android:hint="@string/password" android:inputType="textPassword" android:autofillHints="password" android:imeOptions="actionDone" />
            <TextView android:id="@+id/login_error" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:visibility="gone" android:textColor="@color/danger" android:accessibilityLiveRegion="polite" android:layout_marginTop="12dp" />
            <Button android:id="@+id/login_button" style="@style/PrimaryButton" android:text="@string/login" android:layout_marginTop="24dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>