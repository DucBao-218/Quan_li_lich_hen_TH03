<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView style="@style/ScreenHeading" android:text="@string/detail_heading" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card_background" android:padding="20dp" android:layout_marginTop="24dp">
            <TextView style="@style/FieldLabel" android:text="@string/appointment_title" android:layout_marginTop="0dp" />
            <TextView android:id="@+id/detail_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/primary" />
            <TextView style="@style/FieldLabel" android:text="@string/location" />
            <TextView android:id="@+id/detail_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:textColor="@color/text_primary" />
            <TextView style="@style/FieldLabel" android:text="@string/datetime" />
            <TextView android:id="@+id/detail_datetime" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:textColor="@color/text_primary" />
            <Switch android:id="@+id/detail_reminder" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="18dp" android:text="@string/reminder" android:textSize="16sp" />
            <TextView android:id="@+id/reminder_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="@color/text_secondary" android:accessibilityLiveRegion="polite" />
        </LinearLayout>
        <Button android:id="@+id/back_button" style="@style/PrimaryButton" android:text="@string/back" android:layout_marginTop="24dp" />
        <Button android:id="@+id/delete_button" style="@style/PrimaryButton" android:text="@string/delete_appointment" android:backgroundTint="#FCE8E6" android:textColor="@color/danger" />
    </LinearLayout>
</ScrollView>
