<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/primary" android:padding="22dp">
        <TextView style="@style/ScreenHeading" android:text="@string/schedule_heading" android:textColor="#FFFFFF" android:textSize="25sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/schedule_subtitle" android:textColor="#D9EEE7" android:textSize="14sp" android:layout_marginTop="6dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="20dp" android:paddingBottom="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/stat_background" android:padding="20dp" android:baselineAligned="false">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/total_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="32sp" android:textStyle="bold" android:textColor="#FFFFFF" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/total_label" android:textSize="13sp" android:textColor="#D9EEE7" android:layout_marginTop="4dp" />
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="60dp" android:background="#55FFFFFF" android:layout_marginEnd="20dp" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/reminder_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="32sp" android:textStyle="bold" android:textColor="#FFFFFF" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/reminder_label" android:textSize="13sp" android:textColor="#D9EEE7" android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>
        <TextView style="@style/FieldLabel" android:text="@string/list_heading" android:textSize="18sp" android:layout_marginTop="24dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/list_hint" android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_marginBottom="14dp" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <ListView android:id="@+id/appointment_list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="12dp" android:clipToPadding="false" android:paddingBottom="12dp" />
            <TextView android:id="@+id/empty_list" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/empty_list" android:textSize="16sp" android:textColor="@color/text_secondary" android:visibility="gone" />
        </FrameLayout>
        <Button android:id="@+id/add_button" style="@style/PrimaryButton" android:text="@string/add_appointment" android:layout_marginTop="8dp" />
    </LinearLayout>
</LinearLayout>